# Public Supabase project settings; the anon key is intentionally browser-visible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional documentation and legacy API endpoints.
NEXT_PUBLIC_DOCS_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only settings. Never add a NEXT_PUBLIC_ prefix or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
